         <property name="styleSheet"><string>QTextEdit { background:#1e1e1e; color:#d4d4d4; font-family:monospace; font-size:10px; border-radius:3px; }</string></property>
        </widget>
       </item>

      </layout>
     </widget>

<widget class="QWidget" name="tabTopoAncienne"><attribute name="title"><string>📜 Topo ancienne</string></attribute><layout class="QVBoxLayout" name="vTaOuter"><property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property><item><widget class="QScrollArea" name="scrollTa"><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollTaContents"><layout class="QVBoxLayout" name="vTaInner"><item><widget class="QLabel" name="lblTaInfo"><property name="text"><string>&lt;b&gt;Numérisation de topographie ancienne&lt;/b&gt; — ① caler le scan du plan, ② caler la coupe, ③ retracer la polygonale (un sommet = une station) sur le plan et sur la coupe, ④ calculer la polygonale 3D. Altitude de chaque station : jonction › cote du plan › coupe › interpolation à pente constante.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string>QLabel { background:#e8f4fd; border:1px solid #aad4f0; border-radius:4px; padding:6px; color:#1a4a6b; }</string></property></widget></item><item><widget class="QGroupBox" name="grpTaProject"><property name="title"><string>Cavité</string></property><layout class="QFormLayout" name="f_ta2"><property name="labelAlignment"><set>Qt::AlignRight</set></property><item row="0" column="0"><widget class="QLabel" name="lbl_ta3"><property name="text"><string>Nom</string></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="editTaName"><property name="placeholderText"><string>ex. Clot d'Aspres (topo 1972)</string></property><property name="toolTip"><string>Nom de la cavité / du levé : sert à nommer les fichiers, les groupes QGIS et le survey Therion.</string></property></widget></item><item row="1" column="0"><widget class="QLabel" name="lbl_ta4"><property name="text"><string>Date du levé</string></property></widget></item><item row="1" column="1"><widget class="QLineEdit" name="editTaDate"><property name="placeholderText"><string>ex. 1972 ou 1972.08.15</string></property><property name="toolTip"><string>Date du levé d'origine (métadonnée ; écrite dans le .th si au format AAAA[.MM[.JJ]]). Sert aussi à retrouver la déclinaison.</string></property></widget></item><item row="2" column="0"><widget class="QLabel" name="lbl_ta5"><property name="text"><string>Auteurs du levé</string></property></widget></item><item row="2" column="1"><widget class="QLineEdit" name="editTaAuthors"><property name="placeholderText"><string>ex. J. Dupont, P. Martin</string></property><property name="toolTip"><string>Topographes d'origine (séparés par des virgules) → « team » Therion.</string></property></widget></item><item row="3" column="0"><widget class="QLabel" name="lbl_ta6"><property name="text"><string>Documents sources</string></property></widget></item><item row="3" column="1"><widget class="QLineEdit" name="editTaSources"><property name="placeholderText"><string>ex. Bull. CDS 38 n°12, p. 45 ; archives GUCEM</string></property><property name="toolTip"><string>Référence des documents numérisés : conservée dans les métadonnées.</string></property></widget></item><item row="4" column="0"><widget class="QLabel" name="lbl_ta7"><property name="text"><string>Dossier de sortie</string></property></widget></item><item row="4" column="1"><layout class="QHBoxLayout" name="h_ta1"><item><widget class="QLineEdit" name="editTaOutDir"><property name="placeholderText"><string>vide = à côté du scan du plan</string></property></widget></item><item><widget class="QPushButton" name="btnTaBrowseOut"><property name="maximumWidth"><number>34</number></property><property name="text"><string>📂</string></property></widget></item></layout></item></layout></widget></item><item><widget class="QGroupBox" name="grpTaPlan"><property name="title"><string>① Plan</string></property><layout class="QVBoxLayout" name="v_ta39"><item><layout class="QFormLayout" name="f_ta12"><property name="labelAlignment"><set>Qt::AlignRight</set></property><item row="0" column="0"><widget class="QLabel" name="lbl_ta13"><property name="text"><string>Scan du plan</string></property></widget></item><item row="0" column="1"><layout class="QHBoxLayout" name="h_ta8"><item><widget class="QLineEdit" name="editTaPlanPath"><property name="placeholderText"><string>image du plan (jpg, png, tif, pdf…)</string></property></widget></item><item><widget class="QPushButton" name="btnTaBrowsePlan"><property name="maximumWidth"><number>34</number></property><property name="text"><string>📂</string></property></widget></item><item><widget class="QPushButton" name="btnTaLoadPlan"><property name="text"><string>Charger</string></property><property name="toolTip"><string>Charge le scan. S'il n'est pas géoréférencé, il est affiché en coordonnées image (pixels) en attendant le calage.</string></property><property name="styleSheet"><string>QPushButton { background-color:#1976D2; color:white; padding:5px; border-radius:4px; } QPushButton:hover { background-color:#1565C0; }</string></property></widget></item></layout></item><item row="1" column="0"><widget class="QLabel" name="lbl_ta14"><property name="text"><string>Couche plan</string></property></widget></item><item row="1" column="1"><widget class="QComboBox" name="comboTaPlanLayer"><property name="toolTip"><string>Raster du plan utilisé pour les clics et le calage.</string></property></widget></item><item row="2" column="0"><widget class="QLabel" name="lbl_ta15"><property name="text"><string>Méthode de calage</string></property></widget></item><item row="2" column="1"><layout class="QVBoxLayout" name="v_ta9"><item><widget class="QRadioButton" name="radioTaPlanGeoref"><property name="text"><string>Déjà géoréférencé (Géoréférenceur QGIS…)</string></property><property name="checked"><bool>false</bool></property></widget></item><item><widget class="QRadioButton" name="radioTaPlan2Pts"><property name="text"><string>2 points de coordonnées connues</string></property><property name="checked"><bool>false</bool></property><property name="toolTip"><string>Similitude exacte (échelle + rotation + translation) sur deux points repérables sur le plan et sur le terrain/la carte.</string></property></widget></item><item><widget class="QRadioButton" name="radioTaPlanNorth"><property name="text"><string>Entrée connue + barre d'échelle + flèche nord</string></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>Méthode « historique » : seules l'entrée, l'échelle graphique et la flèche nord sont utilisées.</string></property></widget></item></layout></item><item row="3" column="0"><widget class="QLabel" name="lbl_ta16"><property name="text"><string>Entrée X / Y</string></property></widget></item><item row="3" column="1"><layout class="QHBoxLayout" name="h_ta10"><item><widget class="QDoubleSpinBox" name="spinTaEntryX"><property name="decimals"><number>2</number></property><property name="minimum"><double>-100000000.0</double></property><property name="maximum"><double>100000000.0</double></property><property name="value"><double>0</double></property><property name="singleStep"><double>1.0</double></property><property name="suffix"><string> m</string></property><property name="toolTip"><string>Coordonnée X de l'entrée (SCR du projet).</string></property></widget></item><item><widget class="QDoubleSpinBox" name="spinTaEntryY"><property name="decimals"><number>2</number></property><property name="minimum"><double>-100000000.0</double></property><property name="maximum"><double>100000000.0</double></property><property name="value"><double>0</double></property><property name="singleStep"><double>1.0</double></property><property name="suffix"><string> m</string></property><property name="toolTip"><string>Coordonnée Y de l'entrée (SCR du projet).</string></property></widget></item></layout></item><item row="4" column="0"><widget class="QLabel" name="lbl_ta17"><property name="text"><string>Station de rattachement</string></property></widget></item><item row="4" column="1"><layout class="QHBoxLayout" name="h_ta11"><item><widget class="QLineEdit" name="editTaEntryName"><property name="placeholderText"><string>nom (ex. 0 ou entree@castor)</string></property><property name="toolTip"><string>Nom donné à la 1re station du tracé plan. Si c'est une station d'une cavité déjà saisie, la reconstruction s'y raccorde (jonction Therion).</string></property></widget></item><item><widget class="QPushButton" name="btnTaPickExisting"><property name="text"><string>📍 Station existante</string></property><property name="toolTip"><string>Cliquer sur un point d'une couche de stations (ex. import Therion) : récupère X, Y, Z et le nom.</string></property></widget></item></layout></item><item row="5" column="0"><widget class="QLabel" name="lbl_ta18"><property name="text"><string>Altitude entrée</string></property></widget></item><item row="5" column="1"><widget class="QDoubleSpinBox" name="spinTaEntryZ"><property name="decimals"><number>2</number></property><property name="minimum"><double>-1000</double></property><property name="maximum"><double>9000</double></property><property name="value"><double>0</double></property><property name="singleStep"><double>1.0</double></property><property name="suffix"><string> m</string></property><property name="toolTip"><string>Altitude de l'entrée : valeur par défaut de la coupe et de la 1re station si aucune autre information.</string></property></widget></item></layout></item><item><widget class="QGroupBox" name="grpTaPlan2Pts"><property name="title"><string>Calage sur 2 points</string></property><layout class="QFormLayout" name="f_ta23"><property name="labelAlignment"><set>Qt::AlignRight</set></property><item row="0" column="0"><widget class="QLabel" name="lbl_ta24"><property name="text"><string>Point 1</string></property></widget></item><item row="0" col