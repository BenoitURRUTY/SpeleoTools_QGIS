w="3" column="0"><widget class="QLabel" name="lbl_ta27"><property name="text"><string>X2 / Y2</string></property></widget></item><item row="3" column="1"><layout class="QHBoxLayout" name="h_ta22"><item><widget class="QDoubleSpinBox" name="spinTaP2X"><property name="decimals"><number>2</number></property><property name="minimum"><double>-100000000.0</double></property><property name="maximum"><double>100000000.0</double></property><property name="value"><double>0</double></property><property name="singleStep"><double>1.0</double></property><property name="suffix"><string> m</string></property></widget></item><item><widget class="QDoubleSpinBox" name="spinTaP2Y"><property name="decimals"><number>2</number></property><property name="minimum"><double>-100000000.0</double></property><property name="maximum"><double>100000000.0</double></property><property name="value"><double>0</double></property><property name="singleStep"><double>1.0</double></property><property name="suffix"><string> m</string></property></widget></item></layout></item></layout></widget></item><item><widget class="QGroupBox" name="grpTaPlanNorth"><property name="title"><string>Calage entrée + échelle + nord</string></property><layout class="QFormLayout" name="f_ta32"><property name="labelAlignment"><set>Qt::AlignRight</set></property><item row="0" column="0"><widget class="QLabel" name="lbl_ta33"><property name="text"><string>Entrée</string></property></widget></item><item row="0" column="1"><layout class="QHBoxLayout" name="h_ta28"><item><widget class="QPushButton" name="btnTaPickEntry"><property name="text"><string>🎯 Cliquer</string></property></widget></item><item><widget class="QLabel" name="lblTaEntryPx"><property name="text"><string>— non cliqué —</string></property><property name="styleSheet"><string>color:#9E9E9E;</string></property></widget></item></layout></item><item row="1" column="0"><widget class="QLabel" name="lbl_ta34"><property name="text"><string>Barre d'échelle</string></property></widget></item><item row="1" column="1"><layout class="QHBoxLayout" name="h_ta29"><item><widget class="QPushButton" name="btnTaPickScale"><property name="text"><string>🎯 2 clics</string></property></widget></item><item><widget class="QLabel" name="lblTaScalePx"><property name="text"><string>— non cliqué —</string></property><property name="styleSheet"><string>color:#9E9E9E;</string></property></widget></item></layout></item><item row="2" column="0"><widget class="QLabel" name="lbl_ta35"><property name="text"><string>Longueur barre</string></property></widget></item><item row="2" column="1"><widget class="QDoubleSpinBox" name="spinTaScaleLen"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>100000</double></property><property name="value"><double>10</double></property><property name="singleStep"><double>1.0</double></property><property name="suffix"><string> m</string></property><property name="toolTip"><string>Longueur réelle représentée par la barre d'échelle cliquée.</string></property></widget></item><item row="3" column="0"><widget class="QLabel" name="lbl_ta36"><property name="text"><string>Flèche nord</string></property></widget></item><item row="3" column="1"><layout class="QHBoxLayout" name="h_ta30"><item><widget class="QPushButton" name="btnTaPickNorth"><property name="text"><string>🎯 base → pointe</string></property></widget></item><item><widget class="QLabel" name="lblTaNorthPx"><property name="text"><string>— non cliqué —</string></property><property name="styleSheet"><string>color:#9E9E9E;</string></property></widget></item></layout></item><item row="4" column="0"><widget class="QLabel" name="lbl_ta37"><property name="text"><string>La flèche indique</string></property></widget></item><item row="4" column="1"><layout class="QHBoxLayout" name="h_ta31"><item><widget class="QComboBox" name="comboTaNorthRef"><property name="toolTip"><string>Nature du nord dessiné sur le plan. Le bouton en déduit l'azimut à saisir, dans le SCR du projet.</string></property><item><property name="text"><string>le nord de la grille (quadrillage du SCR)</string></property></item><item><property name="text"><string>le nord géographique (vrai)</string></property></item><item><property name="text"><string>le nord magnétique</string></property></item></widget></item><item><widget class="QDoubleSpinBox" name="spinTaDecl"><property name="decimals"><number>2</number></property><property name="minimum"><double>-45</double></property><property name="maximum"><double>45</double></property><property name="value"><double>0</double></property><property name="singleStep"><double>0.1</double></property><property name="suffix"><string> °</string></property><property name="toolTip"><string>Déclinaison magnétique à la DATE DU LEVÉ (est positif). Calculateur NCEI (modèles gufm1/IGRF, 1590-2029) :
https://www.ngdc.noaa.gov/geomag/calculators/magcalc.shtml</string></property></widget></item><item><widget class="QPushButton" name="btnTaComputeAz"><property name="text"><string>🧭 Calculer</string></property><property name="toolTip"><string>Calcule la convergence des méridiens à l'entrée et en déduit l'azimut de la flèche.</string></property></widget></item></layout></item><item row="5" column="0"><widget class="QLabel" name="lbl_ta38"><property name="text"><string>Azimut réel flèche</string></property></widget></item><item row="5" column="1"><widget class="QDoubleSpinBox" name="spinTaNorthAz"><property name="decimals"><number>2</number></property><property name="minimum"><double>-360</double></property><property name="maximum"><double>360</double></property><property name="value"><double>0</double></property><property name="singleStep"><double>0.1</double></property><property name="suffix"><string> °</string></property><property name="toolTip"><string>Azimut, dans le SCR du projet, vers lequel pointe la flèche dessinée.
Nord de la grille : 0 ; nord géographique : −γ ; nord magnétique : D − γ
(γ = convergence des méridiens, D = déclinaison à la date du levé).
Le bouton 🧭 le calcule. Détails : docs/Calage.md</string></property></widget></item></layout></widget></item><item><widget class="QPushButton" name="btnTaCalibPlan"><property name="text"><string>📐 Caler le plan</string></property><property name="toolTip"><string>Écrit un VRT géoréférencé (l'image source n'est pas modifiée) et le charge.</string></property><property name="styleSheet"><string>QPushButton { background-color:#1976D2; color:white; padding:5px; border-radius:4px; } QPushButton:hover { background-color:#1565C0; }</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox" name="grpTaCoupe"><property name="title"><string>② Coupe</string></property><layout class="QVBoxLayout" name="v_ta55"><item><layout class="QFormLayout" name="f_ta46"><property name="labelAlignment"><set>Qt::AlignRight</set></property><item row="0" column="0"><widget class="QLabel" name="lbl_ta47"><property name="text"><string>Scan de la coupe</string></property></widget></item><item row="0" column="1"><layout class="QHBoxLayout" name="h_ta40"><item><widget class="QLineEdit" name="editTaCoupePath"><property name="placeholderText"><string>image de la coupe</string></property></widget></item><item><widget class="QPushButton" name="btnTaBrowseCoupe"><property name="maximumWidth"><number>34</number></property><property name="text"><string>📂</string></property></widget></item><item><widget class="QPushButton" name="btnTaLoadCoupe"><property name="text"><string>Charger</string></property><property name="styleSheet"><string>QPushButton { background-color:#1976D2; color:white; padding:5px; border-radius:4px; } QPushButton:hover { background-color:#1565C0; }</string></property></widget></item></layout></item><item row="1" column="0"><widget class="QLabel" name="lbl_ta48"><property name="text"><string>Couche coupe</string></property></widget></item><item row="1" column="1"><widget class="QComboBox" name="comboTaCoupeLayer"></widget></item><item row="2" column="0"><widget class="QLabel" name="lbl_ta49"><property name="text"><string>Type de coupe</string></property></widget></item><item row="2" column="1"><layout class="QHBoxLayout" name="h_ta41"><item><widget class="QRadioButton" name="radioTaDev"><property name="text"><string>Développée</string></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>L'abscisse de la coupe est la longueur horizontale cumulée le long de la polygonale.</string></property></widget></item><item><widget class="QRadioButton" name="radioTaProj"><property name="text"><string>Projetée</string></property><property name="checked"><bool>false</bool></property><property name="toolTip"><string>La coupe est une projection sur un plan vertical d'azimut donné.</string></property></widget></item></layout></item><item row="3" column="0"><widget class="QLabel" name="lbl_ta50"><property name="text"><string>Azimut α</string></property></widget></item><item row="3" column="1"><layout class="QHBoxLayout" name="h_ta42"><item><widget class="QDoubleSpinBox" name="spinTaAzimut"><property name="decimals"><number>1</number></property><property name="minimum"><double>0</double></property><property name="maximum"><double>360</double></property><property name="value"><double>0</double></property><property name="singleStep"><double>1.0</double></property><property name="suffix"><string> °</string></property><property name="toolTip"><string>Même convention que Therion « -projection [elevation α] » : l'axe horizontal de la coupe est orienté à α + 90°.</string></property></widget></item><item><widget class="QCheckBox" name="chkTaInvert"><property name="text"><string>Inverser le sens</string></property><property name="checked"><bool>false</bool></property><property name="toolTip"><string>À cocher si la coupe est dessinée « vue de l'autre côté » (le journal le signale).</string></property></widget></item></layout></item><item row="4" column="0"><widget class="QLabel" name="lbl_ta51"><property name="text"><string>Barre d'échelle</string></property></widget></item><item row="4" column="1"><layout class="QHBoxLayout" name="h_ta43"><item><widget class="QPushButton" name="btnTaPickCoupeScale"><property name="text"><string>🎯 2 clics</string></property></widget></item><item><widget class="QLabel" name="lblTaCoupeScalePx"><property name="text"><string>— non cliqué —</string></property><property name="styleSheet"><string>color:#9E9E9E;</string></property></widget></item></layout></item><item row="5" column="0"><widget class="QLabel" name="lbl_ta52"><property name="text"><string>Longueur barre</string></property></widget></item><item row="5" column="1"><widget class="QDoubleSpinBox" name="spinTaCoupeScaleLen"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.001</double></property><property name="maximum"><double>100000</double></property><property name="value"><double>10</double></property><property name="singleStep"><double>1.0</double></property><property name="suffix"><string> m</string></property></widget></item><item row="6" column="0" colspan="2"><widget class="QCheckBox" name="chkTaBarHoriz"><property name="text"><string>La barre est horizontale : redresser le scan si elle est penchée</string></property><property name="checked"><bool>true</bool></property></widget></item><item row="7" column="0"><widget class="QLabel" name="lbl_ta53"><property name="text"><string>Point de référence</string></property></widget></item><item row="7" column="1"><layout class="QHBoxLayout" name="h_ta44"><item><widget class="QPushButton" name="btnTaPickCoupeRef"><property name="text"><string>🎯 Cliquer</string></property></widget></item><item><widget class="QLabel" name="lblTaCoupeRefPx"><property name="text"><string>— non cliqué —</string></property><property name="styleSheet"><string>color:#9E9E9E;</string></property></widget></item></layout></item><item row="8" column="0"><widget class="QLabel" name="lbl_ta54"><property name="text"><string>X / Z référence</string></property></widget></item><item row="8" column="1"><layout class="QHBoxLayout" name="h_ta45"><item><widget class="QDoubleSpinBox" name="spinTaCoupeRefX"><property name="decimals"><number>2</number></property><property name="minimum"><double>-100000</double></property><property name="maximum"><double>100000</double></property><property name="value"><double>0</double></property><property name="singleStep"><double>1.0</double></property><property name="suffix"><string> m</string></property><property name="toolTip"><string>Abscisse du point de référence sur la coupe (0 pour l'entrée).</string></property></widget></item><item><widget class="QDoubleSpinBox" name="spinTaCoupeRefZ"><property name="decimals"><number>2</number></property><property name="minimum"><double>-1000</double></property><property name="maximum"><double>9000</double></property><property name="value"><double>0</double></property><property name="singleStep"><double>1.0</double></property><property name="suffix"><string> m</string></property><property name="toolTip"><string>Altitude du point de référence (souvent l'altitude de l'entrée).</string></property></widget></item></layout></item></layout></item><item><widget class="QPushButton" name="btnTaCalibCoupe"><property name="text"><string>📐 Caler la coupe</string></property><property name="toolTip"><string>La coupe calée est affichée sous le plan (≈ 10 km) : X_affiché = X + X_entrée, Y_affiché = Z + Y_entrée − 10 000.</string></property><property name="styleSheet"><string>QPushButton { background-color:#1976D2; color:white; padding:5px; border-radius:4px; } QPushButton:hover { background-color:#1565C0; }</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox" name="grpTaDraw"><property name="title"><string>③ Tracé des polygonales</string></property><layout class="QVBoxLayout" name="v_ta62"><item><layout class="QFormLayout" name="f_ta56"><property name="labelAlignment"><set>Qt::AlignRight</set></property><item row="0" column="0"><widget class="QLabel" name="lbl_ta57"><property name="text"><string>Tracé plan</string></property></widget></item><item row="0" column="1"><widget class="QComboBox" name="comboTaPlanLine"><property name="toolTip"><string>Laisser « tracé SpeleoTools » ou choisir une couche de lignes existante.</string></property></widget></item><item row="1" column="0"><widget class="QLabel" name="lbl_ta58"><property name="text"><string>Tracé coupe</string></property></widget></item><item row="1" column="1"><widget class="QComboBox" name="comboTaCoupeLine"></widget></item></layout></item><item><layout class="QHBoxLayout" name="h_ta59"><item><widget class="QPushButton" name="btnTaDrawPlan"><property name="text"><string>✏ Tracer sur le plan</string></property></widget></item><item><widget class="QPushButton" name="btnTaDrawCoupe"><property name="text"><string>✏ Tracer sur la coupe</string></property></widget></item></layout></item><item><layout class="QHBoxLayout" name="h_ta60"><item><widget class="QPushButton" name="btnTaFinishDraw"><property name="text"><string>✔ Terminer le tracé</string></property><property name="toolTip"><string>Enregistre les tracés et (re)génère les stations.</string></property></widget></item><item><widget class="QPushButton" name="btnTaZoomPlan"><property name="text"><string>🔍 Plan</string></property></widget></item><item><widget class="QPushButton" name="btnTaZoomCoupe"><property name="text"><string>🔍 Coupe</string></property></widget></item></layout></item><item><layout class="QHBoxLayout" name="h_ta61"><item><widget class="QPushButton" name="btnTaMakeStations"><property name="text"><string>⟳ Mettre à jour les stations</string></property><property name="toolTip"><string>Recrée les points stations depuis les tracés en conservant noms et cotes déjà saisis.</string></property></widget></item><item><widget class="QPushButton" name="btnTaOpenTable"><property name="text"><string>📋 Tables des stations</string></property></widget></item></layout></item><item><widget class="QLabel" name="lblTaDrawHint"><property name="text"><string>Un clic par station, clic droit pour terminer une branche. Une polyligne par branche, dans le sens de la topographie, avec le même n° de « branche » sur le plan et sur la coupe. Pour apparier plan et coupe, donnez le même « nom » aux stations homologues (au minimum : les haut et bas de puits). Les cotes écrites sur le plan vont dans « z_plan ».</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string>QLabel { color:#555; font-style:italic; }</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox" name="grpTaCalc"><property name="title"><string>④ Calcul de la polygonale 3D</string></property><layout class="QFormLayout" name="f_ta63"><property name="labelAlignment"><set>Qt::AlignRight</set></property><item row="0" column="0" colspan="2"><widget class="QCheckBox" name="chkTaPairOrder"><property name="text"><string>Apparier par ordre des sommets si plan et coupe en ont le même nombre</string></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>Utilisé seulement si aucun nom commun n'est trouvé dans la branche.</string></property></widget></item><item row="1" column="0"><widget class="QLabel" name="lbl_ta64"><property name="text"><string>Tolérance abscisse</string></property></widget></item><item row="1" column="1"><widget class="QDoubleSpinBox" name="spinTaTol"><property name="decimals"><number>2</number></property><property name="minimum"><double>0</double></property><property name="maximum"><double>50</double></property><property name="value"><double>0.5</double></property><property name="singleStep"><double>0.1</double></property><property name="suffix"><string> m</string></property><property name="toolTip"><string>Tolérance pour accrocher une station du plan à la coupe quand son abscisse tombe juste hors du tracé.</string></property></widget></item><item row="2" column="0"><widget class="QLabel" name="lbl_ta65"><property name="text"><string>Jonction auto</string></property></widget></item><item row="2" column="1"><widget class="QDoubleSpinBox" name="spinTaJoinTol"><property name="decimals"><number>2</number></property><property name="minimum"><double>0</double></property><property name="maximum"><double>5</double></property><property name="value"><double>0.1</double></property><property name="singleStep"><double>0.05</double></property><property name="suffix"><string> m</string></property><property name="toolTip"><string>Une station non nommée située à moins de cette distance d'une station déjà calculée est fusionnée avec elle (jonction).</string></property></widget></item><item row="3" column="0" colspan="2"><widget class="QCheckBox" name="chkTaGuides"><property name="text"><string>Afficher sur la coupe les verticales des stations du plan (contrôle)</string></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>Trace, sur la coupe calée, la verticale de chaque station du plan et la position 3D obtenue.</string></property></widget></item><item row="4" column="0" colspan="2"><widget class="QCheckBox" name="chkTaExportTh"><property name="text"><string>Exporter une centerline Therion (.th)</string></property><property name="checked"><bool>true</bool></property></widget></item><item row="5" column="0"><widget class="QLabel" name="lbl_ta66"><property name="text"><string>Style des visées</string></property></widget></item><item row="5" column="1"><widget class="QComboBox" name="comboTaThStyle"><property name="toolTip"><string>Cartésien : différences de coordonnées, aucune ambiguïté de déclinaison.
Normal : longueur, azimut et pente — spéléométrie lisible ; les azimuts sont
rapportés au nord géographique (gisement + convergence) et le fichier déclare
declination 0.</string></property><item><property name="text"><string>cartésien (dx, dy, dz)</string></property></item><item><property name="text"><string>normal (longueur, azimut, pente)</string></property></item></widget></item></layout></widget></item><item><widget class="QPushButton" name="btnTaRun"><property name="text"><string>▶  Calculer la polygonale 3D</string></property><property name="toolTip"><string>Stations 3D, visées 3D et polygonale 3D (GPKG), CSV des visées, fichier Therion.</string></property><property name="styleSheet"><string>QPushButton { background-color:#388E3C; color:white; padding:7px; border-radius:4px; font-weight:bold; } QPushButton:hover { background-color:#2E7D32; }</string></property></widget></item><item><widget class="QProgressBar" name="progressTa"><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="value"><number>0</number></property></widget></item><item><widget class="QGroupBox" name="grpTaControl"><property name="title"><string>⑤ Contrôle par rapport à un levé de référence</string></property><layout class="QVBoxLayout" name="v_ta69"><item><layout class="QFormLayout" name="f_ta67"><property name="labelAlignment"><set>Qt::AlignRight</set></property><item row="0" column="0"><widget class="QLabel" name="lbl_ta68"><property name="text"><string>Stations de référence</string></property></widget></item><item row="0" column="1"><widget class="QComboBox" name="comboTaRefLayer"><property name="toolTip"><string>Couche de points d'un levé fiable (ex. Stations 3D d'un import Therion). Les stations sont appariées par leur nom.</string></property></widget></item></layout></item><item><widget class="QPushButton" name="btnTaCompare"><property name="text"><string>📏 Comparer les stations reconstruites</string></property><property name="toolTip"><string>Écarts X/Y/Z par station homologue, statistiques et couche de vecteurs d'écart.</string></property></widget></item></layout><